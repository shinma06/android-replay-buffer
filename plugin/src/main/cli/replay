#!/bin/sh
set -eu
plugin_dir=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
case $(uname -s) in
    Darwin) default_home='/Applications/Android Studio.app/Contents' ;;
    *) default_home=/opt/android-studio ;;
esac
studio_home=${REPLAY_STUDIO_HOME:-$default_home}
java="$studio_home/jbr/Contents/Home/bin/java"
[ -x "$java" ] || java="$studio_home/jbr/bin/java"
if [ ! -x "$java" ] || [ ! -f "$studio_home/lib/util-8.jar" ]; then
    printf '%s\n' '対応するAndroid Studioの導入先（macOSはContents）をREPLAY_STUDIO_HOMEで指定してください。' >&2
    exit 1
fi
exec "$java" --enable-native-access=ALL-UNNAMED -cp "$plugin_dir/lib/*:$studio_home/lib/util-8.jar" io.github.shinma06.replaybuffer.cli.ReplayCli "$@"
