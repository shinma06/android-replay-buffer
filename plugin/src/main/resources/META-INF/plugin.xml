<idea-plugin>
    <id>io.github.shinma06.android-replay-buffer</id>
    <name>Android Replay Buffer</name>
    <vendor url="https://github.com/shinma06/android-replay-buffer">shinma06</vendor>
    <description><![CDATA[
        Development foundation for an Android screen and log replay buffer.
        Android操作直前の画面・logcatを保存するプラグインの開発基盤です。
        現段階では情報表示のみで、録画・保存は既存のPython CLIを使用します。
    ]]></description>
    <depends>com.intellij.modules.platform</depends>
    <depends>org.jetbrains.android</depends>
    <depends>com.intellij.modules.androidstudio</depends>
    <extensions defaultExtensionNs="com.intellij">
        <toolWindow id="Android Replay Buffer"
                    anchor="right"
                    doNotActivateOnStart="true"
                    icon="AllIcons.Actions.Restart"
                    factoryClass="io.github.shinma06.replaybuffer.ui.ReplayToolWindowFactory"/>
        <projectConfigurable parentId="tools"
                             nonDefaultProject="true"
                             id="io.github.shinma06.replaybuffer.settings"
                             displayName="Android Replay Buffer"
                             instance="io.github.shinma06.replaybuffer.settings.ReplaySettingsConfigurable"/>
        <postStartupActivity implementation="io.github.shinma06.replaybuffer.ide.ReplayProjectActivity"/>
    </extensions>
    <actions>
        <action id="io.github.shinma06.replaybuffer.About"
                class="io.github.shinma06.replaybuffer.AboutReplayBufferAction"
                text="Android Replay Bufferについて"
                description="開発状況とプラグインのバージョンを表示します">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
        </action>
    </actions>
</idea-plugin>
