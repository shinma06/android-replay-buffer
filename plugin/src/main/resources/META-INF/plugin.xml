<idea-plugin>
    <id>io.github.shinma06.android-replay-buffer</id>
    <name>Android Replay Buffer</name>
    <vendor url="https://github.com/shinma06/android-replay-buffer">shinma06</vendor>
    <description><![CDATA[
        Android Replay Buffer captures recent screen and logcat history from an Android device.
        Android Replay Bufferは、Android操作直前の画面・logcatを保存します。
        専用ToolWindowから取得を有効にし、直前の記録を保存・再試行できます。
        Settings → Tools → Android Replay Bufferで保存先と取得条件を設定します。
        初回は取得が無効です。初期版は1台のAndroid端末に対応します。
    ]]></description>
    <depends>com.intellij.modules.platform</depends>
    <depends>org.jetbrains.android</depends>
    <depends>com.intellij.modules.androidstudio</depends>
    <depends>com.intellij.modules.compose</depends>
    <extensions defaultExtensionNs="com.intellij">
        <notificationGroup id="Android Replay Buffer" displayType="BALLOON" isLogByDefault="true"/>
        <toolWindow id="Android Replay Buffer"
                    anchor="right"
                    doNotActivateOnStart="true"
                    icon="AllIcons.Actions.Restart"
                    factoryClass="io.github.shinma06.replaybuffer.ui.ReplayToolWindowFactory"/>
        <projectConfigurable parentId="tools"
                             nonDefaultProject="true"
                             id="io.github.shinma06.replaybuffer.settings"
                             displayName="Android Replay Buffer"
                             instance="io.github.shinma06.replaybuffer.settings.ReplaySettingsConfigurable"/>
        <postStartupActivity implementation="io.github.shinma06.replaybuffer.ide.ReplayProjectActivity"/>
    </extensions>
    <projectListeners>
        <listener class="io.github.shinma06.replaybuffer.ui.LogcatTitleActions"
                  topic="com.intellij.openapi.wm.ex.ToolWindowManagerListener"/>
    </projectListeners>
    <actions>
        <action id="io.github.shinma06.replaybuffer.About"
                class="io.github.shinma06.replaybuffer.AboutReplayBufferAction"
                text="Android Replay Bufferについて"
                description="使い方とプラグインのバージョンを表示します">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
        </action>
        <group id="io.github.shinma06.replaybuffer.RunningDevices">
            <separator/>
            <action id="io.github.shinma06.replaybuffer.RunningDevices.Capture"
                    class="io.github.shinma06.replaybuffer.ui.ReplayCaptureToggleAction"
                    text="Replay Bufferの取得を切り替える"
                    description="Replay Bufferの取得を有効・無効にします"/>
            <action id="io.github.shinma06.replaybuffer.RunningDevices.Save"
                    class="io.github.shinma06.replaybuffer.ui.ReplaySaveAction"
                    text="Replay Buffer: 直前の記録を保存"
                    description="直前の画面とログを保存します"/>
            <action id="io.github.shinma06.replaybuffer.RunningDevices.Screenshot"
                    class="io.github.shinma06.replaybuffer.ui.ReplayScreenshotAction"
                    text="Replay Buffer: スクリーンショット"
                    description="録画対象の端末の現在画面を保存します"/>
            <add-to-group group-id="StreamingToolbarSecondary" anchor="last"/>
        </group>
        <group id="io.github.shinma06.replaybuffer.Logcat">
            <separator/>
            <action id="io.github.shinma06.replaybuffer.Logcat.SaveLogs"
                    class="io.github.shinma06.replaybuffer.ui.ReplayLogSaveAction"
                    text="Replay Buffer: 直前のログを保存"
                    description="端末ログ・アプリログだけを保存します。動画の取得中でも動画は保存しません"/>
            <add-to-group group-id="Logcat.PopupActions" anchor="last"/>
        </group>
    </actions>
</idea-plugin>
